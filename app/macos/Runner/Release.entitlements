<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed outside the App Store: no sandbox, so it can reach any Ashira server
	     (LAN addresses included), open the files the user picks and run its updater. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
